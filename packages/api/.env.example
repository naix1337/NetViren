# Authentication
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars-long!!
AGENT_SECRET=change-me-to-a-shared-secret-for-agent-registration

# Database (default: in-memory for development)
DATABASE_PATH=:memory:

# API Server
API_PORT=4000
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Agent Handler
AGENT_HANDLER_PORT=4001

# VirusTotal (optional)
VT_API_KEY=
VT_API_URL=https://www.virustotal.com/api/v3

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=

# Scanning
SCAN_INTERVAL_MINUTES=60
PORT_RANGES=20-25,53,80,110,143,443,445,993,995,1433,1521,2049,3306,3389,5432,5900,6379,8080,8443,27017
PACKET_RETENTION_DAYS=7

# Logging
LOG_LEVEL=info
NODE_ENV=development
